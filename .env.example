# Copy to .env:  cp .env.example .env
HTTP_ADDR=:8080
DATABASE_URL=postgres://baggage:baggage@localhost:5432/baggage_eval?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QUEUE_NAME=evaluation.jobs
DEAD_LETTER_QUEUE=evaluation.jobs.dlq

# Retry settings for the worker
MAX_ATTEMPTS=3
RETRY_BACKOFF=2s

# Evaluation thresholds (see docs/annotation-guidelines.md)
LOW_CONFIDENCE_THRESHOLD=0.50
REVIEW_THRESHOLD=0.75
HIGH_CONFIDENCE_THRESHOLD=0.90
